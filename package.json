{
  "name": "ai-prompt-templates",
  "version": "1.0.0",
  "description": "Vibe Coding Made Easy - Quick Copy-Paste Queries for Faster AI Communication",
  "main": "src/index.js",
  "scripts": {
    "start": "http-server . -p 3000 -c-1",
    "dev": "http-server . -p 3001 -c-1 --cors",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "clean": "rmdir /s /q dist"
  },
  "keywords": [
    "ai",
    "prompts",
    "coding",
    "templates",
    "cline",
    "development"
  ],
  "author": "AI Prompt Templates",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.5.1",
    "eslint": "^8.55.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "style-loader": "^3.3.3",
    "css-loader": "^6.8.1",
    "typescript": "^5.3.3",
    "@types/jest": "^29.5.8"
  },
  "repository": {
