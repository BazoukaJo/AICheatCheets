{
  "name": "ai-prompt-assistant",
  "version": "1.0.0",
  "description": "Vibe Coding Made Easy - Quick Copy-Paste Queries for Faster AI Communication",
  "main": "app.js",
  "scripts": {
    "start": "http-server . -p 3000 -c-1",
    "dev": "http-server . -p 3000 -c-1 --cors",
    "build": "npm run lint && npm run minify",
    "minify": "terser app.js -o app.min.js --compress --mangle",
    "lint": "eslint app.js --fix",
    "test": "jest",
    "serve": "npm start"
  },
  "keywords": [
    "ai",
    "prompts",
    "coding",
    "assistant",
    "cline",
    "development"
  ],
  "author": "AI Prompt Assistant",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "terser": "^5.27.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ai-prompt-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ai-prompt-assistant/issues"
  },
  "homepage": "https://github.com/yourusername/ai-prompt-assistant#readme"
}
